APP_NAME=VoxTrace
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/voxtrace_db
DATABASE_SCHEMA=voxtrace
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=voxtrace_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=28800
STORAGE_ROOT=storage/audio
MAX_AUDIO_SIZE_MB=100
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
SPEECHBRAIN_MODEL_SOURCE=speechbrain/spkrec-ecapa-voxceleb
SPEECHBRAIN_MODEL_DIR=storage/models/speechbrain/spkrec-ecapa-voxceleb
BIOMETRIC_THRESHOLD_COSINE=0.6281865036
BIOMETRIC_THRESHOLD_EFFECTIVE_AT=2026-10-04T23:13:27
